---
import type { CollectionEntry } from 'astro:content';
import { postHref, isArchivedPost } from '../lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;

const date = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
}).format(post.data.pubDate);
---

<li class="post-card">
  <h2 class="post-card__title">
    <a href={postHref(post)}>{post.data.title}</a>
  </h2>
  <p class="post-card__meta">
    {isArchivedPost(post) && <span class="badge">已归档</span>}
    <time datetime={post.data.pubDate.toISOString()}>{date}</time>
  </p>
  <p class="post-card__desc">{post.data.description}</p>
</li>
