---
import type { CollectionEntry } from 'astro:content';
// MarkdownHeading 从 'astro' 拿，不是 'astro:content'（Astro 7 实测：
// 后者没有这个导出，astro check 会报 ts(2305)）。
import type { MarkdownHeading } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import TagList from '../components/TagList.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { SITE_NAME, SITE_URL, GITHUB_URL } from '../site.config';
import { readingStats, formatCount } from '../lib/reading-time';
import { postHref, isArchivedPost, type Post } from '../lib/posts';

interface Props {
  post: CollectionEntry<'posts'>;
  /** 由 Astro 的 rehypeHeadingIds 生成，页面从 render() 里取来交给这里 */
  headings: MarkdownHeading[];
  /** 时间上更早 / 更晚的一篇；两头为 undefined（见 lib/posts.ts 的约定） */
  older?: Post;
  newer?: Post;
}

const { post, headings, older, newer } = Astro.props;

const slug = post.data.slug ?? post.id;
const canonical = new URL(`/posts/${slug}/`, SITE_URL).toString();
/** 本页自己的分享卡片，构建期烘好（见 src/pages/og/[slug].png.ts） */
const ogImage = new URL(`/og/${slug}.png`, SITE_URL).toString();

// 字数与阅读时间：从原始 Markdown 现算，不手写进 frontmatter
// （手写就会出现"忘了改"的第二真相源）。
// 代码块被排除在统计外，理由见 lib/reading-time.ts。
const stats = readingStats(post.body ?? '');

const fmt = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogImage={ogImage}
  ogImageAlt={post.data.title}
>
  <!--
    代码块用的自托管等宽字体。**只在文章页 preload**——首页/归档/标签页没有
    代码块，没必要让它们白下载这 21 KB。crossorigin 是字体 preload 的必需项
    （字体按 CORS 取，缺了它 preload 与真实请求对不上，会重复下载）。
  -->
  <link
    slot="head"
    rel="preload"
    as="font"
    type="font/woff2"
    href="/fonts/jetbrains-mono-latin.woff2"
    crossorigin
  />

  <link slot="head" rel="canonical" href={canonical} />

  <!--
    结构化元数据（schema.org BlogPosting）。给解析 JSON-LD 的 agent/搜索引擎用，
    不必从正文里猜标题、日期、作者、标签。放在 head 具名插槽里。
  -->
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      datePublished: post.data.pubDate.toISOString(),
      dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
      author: { '@type': 'Person', name: SITE_NAME, url: GITHUB_URL },
      publisher: { '@type': 'Person', name: SITE_NAME, url: GITHUB_URL },
      mainEntityOfPage: canonical,
      image: ogImage,
      keywords: post.data.tags?.join(', '),
      inLanguage: 'zh-CN',
    })}
  />

  <article>
    <!--
      已归档横幅。刻意放在**标题之前**：读者在读到第一行正文前就该知道
      "这篇不再更新、结论可能过时"，而不是读完才发现。
      判据是"文件在不在 archive/ 目录里"，不读 frontmatter
      （见 content.config.ts 末尾与 lib/posts.ts 的 isArchivedPost）。
    -->
    {
      isArchivedPost(post) && (
        <p class="article-flag">
          <strong>已归档</strong>
          ：这篇内容保留在原处且外链有效，但<strong>不再更新</strong>，
          其中的结论可能已随版本变化而过时。
        </p>
      )
    }

    <header class="article-header">
      {
        post.data.cover && (
          <Image
            class="article-cover"
            src={post.data.cover}
            alt={post.data.coverAlt ?? ''}
            loading="eager"
          />
        )
      }

      <h1 class="article-title">{post.data.title}</h1>
      <p class="article-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {fmt.format(post.data.pubDate)}
        </time>
        {
          post.data.updatedDate && (
            <span>
              {' '}
              · 更新于 {fmt.format(post.data.updatedDate)}
            </span>
          )
        }
        <span>
          {' '}
          · {formatCount(stats.cjk)} 字
        </span>
        <span>
          {' '}
          · 约 {stats.minutes} 分钟
        </span>
      </p>
      <TagList tags={post.data.tags} />
    </header>

    <TableOfContents headings={headings} />

    <div class="prose">
      <slot />
    </div>
  </article>

  <!--
    上一篇 / 下一篇。读完一篇后原本无处可去、只能回列表重找。
    约定（与 lib/posts.ts 同源）：上一篇 = 时间上更早，下一篇 = 时间上更晚；
    首篇/末篇各自少一侧，不留死链。
  -->
  <nav class="post-nav" aria-label="相邻文章">
    {
      older ? (
        <a class="post-nav__link" href={postHref(older)} rel="prev">
          <span class="post-nav__label">← 上一篇（更早）</span>
          <span class="post-nav__title">{older.data.title}</span>
        </a>
      ) : (
        <span class="post-nav__empty" />
      )
    }
    {
      newer ? (
        <a class="post-nav__link post-nav__link--next" href={postHref(newer)} rel="next">
          <span class="post-nav__label">下一篇（更新）→</span>
          <span class="post-nav__title">{newer.data.title}</span>
        </a>
      ) : (
        <span class="post-nav__empty" />
      )
    }
  </nav>

  <!--
    代码块装饰：给每个 pre.astro-code 包一层 figure.code-figure，
    顶部生成一条 code-bar（左侧语言/文件名标注，右侧复制按钮）。

    语言取自 Shiki 写入的 data-language；若围栏写了 meta（如 ```c title="main.c"），
    meta 优先显示，这样既能标类型也能标文件名。

    MDX 内容不走组件，所以只能在渲染后统一注入。刻意用内联脚本而非框架：
    这是全站唯一一处功能性 JS（连同主题切换，约 1 KB）。
  -->
  <script is:inline>
    document.querySelectorAll('pre.astro-code').forEach((pre) => {
      if (
        pre.parentElement &&
        pre.parentElement.classList.contains('code-figure')
      ) {
        return;
      }

      const lang = pre.getAttribute('data-language') || 'text';
      const meta = (pre.getAttribute('data-meta') || '').trim();
      const label = meta || lang;

      const bar = document.createElement('div');
      bar.className = 'code-bar';

      const span = document.createElement('span');
      span.className = 'code-lang';
      span.textContent = label;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'code-copy';
      btn.textContent = '复制';
      btn.setAttribute('aria-label', '复制代码');

      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        const text = code ? code.innerText : pre.innerText;
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = '已复制';
        } catch {
          btn.textContent = '复制失败';
        }
        setTimeout(() => {
          btn.textContent = '复制';
        }, 1600);
      });

      bar.append(span, btn);

      const fig = document.createElement('figure');
      fig.className = 'code-figure';
      pre.parentNode.insertBefore(fig, pre);
      fig.append(bar, pre);
    });
  </script>
</BaseLayout>
